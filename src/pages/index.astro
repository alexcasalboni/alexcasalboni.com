---
import BaseLayout from '@layouts/BaseLayout.astro';
import NavBar from '@components/NavBar.astro';
import Hero from '@components/Hero.astro';
import Highlights from '@components/Highlights.astro';
import SectionHeader from '@components/SectionHeader.astro';
import ArticleCard from '@components/ArticleCard.astro';
import TalkCard from '@components/TalkCard.astro';
import Footer from '@components/Footer.astro';
import { writing, talks } from '@data/content';
---

<BaseLayout>
  <NavBar />
  <main>
    <div class="content-shell">
      <Hero />

      <SectionHeader
        subtitle="Deep technical background, hands-on developer experience, and practical education."
        title="What you can expect"
      />
      <Highlights />

      <SectionHeader
        subtitle="Curated essays, guides, and playbooks that resonated with the community."
        title="Latest writing"
      />
      <div class="grid writing">
        {writing.slice(0, 3).map((article) => (
          <ArticleCard {...article} />
        ))}
      </div>
      <div class="see-more">
        <a href="/writing">Browse all articles →</a>
      </div>

      <SectionHeader
        subtitle="From conference keynotes to livestreams, here are a few favorites."
        title="Talks & live sessions"
      />
      <div class="grid talks">
        {talks.slice(0, 2).map((talk) => (
          <TalkCard {...talk} />
        ))}
      </div>
      <div class="see-more">
        <a href="/talks">Watch more talks →</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .writing {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .talks {
    grid-template-columns: 1fr;
  }

  /* Remove glow from cards by default on homepage */
  :global(.content-shell .glass) {
    box-shadow: none;
  }

  /* Keep glow on hero */
  :global(.hero.glass) {
    box-shadow: var(--glow);
  }

  .see-more {
    margin: 1.5rem 0 3rem;
  }

  @media (min-width: 900px) {
    .talks {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
